# Plantilla de variables para docker-compose.yml
# En el servidor se copia como `.env` (gitignored) con valores reales.

# MySQL (contenedor db)
DB_ROOT_PASSWORD=cambiar_root_aqui
DB_USER=gestionsocial
DB_PASSWORD=cambiar_app_aqui

# JWT (backend) — reutilizar el mismo JWT_SECRET del backend/.env actual
JWT_SECRET=cambiar_secret_aqui
JWT_EXPIRES_IN=8h
